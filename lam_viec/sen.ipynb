    "    return S\n",
    "\n",
    "def box_sum(S, y1, x1, y2, x2):\n",
    "    return S[y2 + 1, x2 + 1] - S[y1, x2 + 1] - S[y2 + 1, x1] + S[y1, x1]\n",
