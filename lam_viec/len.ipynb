    "    [\"Original (zoom)\", \"Blurred input (zoom)\", f\"Sharpened, alpha={alpha} (zoom)\"]\n",
    "):\n",
    "    ax.imshow(im[r0:r1, c0:c1], cmap=\"gray\", vmin=0, vmax=255,\n",
    "              interpolation=\"nearest\")\n",
