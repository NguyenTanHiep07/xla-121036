    "# Phóng to vùng cạnh để so sánh gốc / mờ / sắc nét\n",
    "r0, r1, c0, c1 = 55, 95, 25, 65   # vùng quanh cạnh trái của hình chữ nhật sáng\n",
    "row = 75                          # hàng dùng để vẽ mặt cắt cường độ\n",
    "\n",
